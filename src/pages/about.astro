---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="About us" description="Takweyat International Organization is a dynamic collective of civil society members: lawyers, doctors, educators, and social workers.">
  <section class="pillar-hero" style="--c:var(--teal)">
    <div class="wrap phg-grid">
      <div class="ph-text">
        <p class="crumbs"><a href="/about/">About us</a></p>
        <h1 class="h1">A Coalition of Professionals. A Commitment to Society.</h1>
        <div class="btns" style="margin-top:32px"><a class="btn white" href="/join/"><span>Join the movement</span><Arrow /></a></div>
      </div>
      <div class="ph-art"><img src="/media/banners/about.jpg" alt="" width="2400" height="1350" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap about-intro">
      <p class="small" style="font-weight:700;letter-spacing:.08em;text-transform:uppercase">Who we are</p>
      <p class="about-lede" data-rise>Takweyat International Organization (تقویت) is a dynamic collective of civil society members originating from diverse professional backgrounds. We are lawyers, doctors, educators, and social workers who believe that true societal strength comes from active, on-ground participation rather than passive observation. Grounded in core Islamic values of justice, ethical responsibility, and brotherhood, we pool our own professional expertise and time to intervene where society needs it most. Whether it is providing pro-bono legal defense, setting up medical camps, or executing disaster relief, Takweyat is driven purely by the power of human capital and community dedication.</p>
      <ul class="roles" aria-label="Who is in Takweyat"><li>Lawyers</li><li>Doctors</li><li>Educators</li><li>Social workers</li></ul>
    </div>
  </section>

  <section class="band bg-white">
    <div class="wrap cols2 wide-left" style="align-items:start">
      <h2 class="h2">Our Structure: The Power of Civil Society</h2>
      <div>
        <p class="lede" data-rise>We are not a traditional charity; we are a multidisciplinary movement. Our main organizational body is composed of respected members of civil society who volunteer their specialized skills to create systemic, long-term change. By uniting different professions under one banner, we ensure that every challenge—from human rights violations to climate disasters—is met with expert, actionable solutions.</p>
        <ul class="roles" style="margin-top:28px" aria-label="Our values"><li>Justice</li><li>Ethical responsibility</li><li>Brotherhood</li></ul>
      </div>
    </div>
  </section>

  <section class="band bg-charcoal quote">
    <div class="wrap qwrap">
      <figure>
        <p class="small" style="margin-bottom:20px;font-weight:700">Founder’s Message</p>
        <blockquote class="long">“Throughout my career in the legal field, I have witnessed the devastating impact of systemic neglect. I also realized that the solution lies within us—the professionals and active members of civil society. Takweyat (تقویت) was born from the realization that we cannot wait for others to fix our society. We do not ask for your funds; we ask for your expertise. From fighting human rights violations in the courtroom to delivering medical aid on the streets, our commitment is fueled by the personal dedication of our members. I invite professionals from all walks of life to join us in this mission of empathy, justice, and actionable change.”</blockquote>
      </figure>
    </div>
  </section>

  <section class="band bg-raspberry cta-band">
    <div class="wrap cols2 wide-left" style="align-items:center">
      <h2 class="h2">Join us in this mission</h2>
      <div class="btns">
        <a class="btn white" href="/get-involved/"><span>Get involved</span><Arrow /></a>
        <a class="btn ghost" href="/join/"><span>Join the movement</span></a>
      </div>
    </div>
  </section>
</Base>
