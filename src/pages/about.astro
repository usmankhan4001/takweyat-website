---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'about');
---
<Base title={t('about_us')} description="Takweyat International Organization is a dynamic collective of civil society members: lawyers, doctors, educators, and social workers.">
  <section class="bighero" style="--img:url(/media/banners/about.jpg)">
    <div class="wrap bh-in">
      <h1 class="bh-title">{t('a_coalition_of_professionals_a_commitment')}</h1>
      <div class="btns"><a class="btn white" href="/join/"><span>{t('join_the_movement')}</span><Arrow /></a></div>
    </div>
  </section>

  <section class="field-teal">
    <div class="wrap">
      <p class="field-big" data-rise>{t('takweyat_international_organization_is_a_dynamic')}</p>
    </div>
  </section>

  <section class="bleed-video" aria-hidden="true">
    <video src="/media/islamabad.mp4" poster="/media/islamabad.jpg" autoplay muted loop playsinline preload="none"></video>
  </section>

  <section class="band bg-white">
    <div class="wrap cols2 wide-left" style="align-items:start">
      <h2 class="h2 big-h2">{t('our_structure_the_power_of_civil')}</h2>
      <p class="lede" data-rise>{t('we_are_not_a_traditional_charity')}</p>
    </div>
  </section>

  <section class="band bg-charcoal quote">
    <div class="wrap qwrap">
      <figure>
        <p class="small" style="margin-bottom:20px;font-weight:700">{t('founder_s_message')}</p>
        <blockquote class="long">{t('throughout_my_career_in_the_legal')}</blockquote>
      </figure>
    </div>
  </section>

  <section class="field-raspberry">
    <div class="wrap">
      <h2 class="field-huge">{t('join_us_in_this_mission')}</h2>
      <div class="btns" style="margin-top:36px">
        <a class="btn white" href="/get-involved/"><span>{t('get_involved')}</span><Arrow /></a>
        <a class="btn ghost" href="/join/"><span>{t('join_the_movement_2')}</span></a>
      </div>
    </div>
  </section>
</Base>
