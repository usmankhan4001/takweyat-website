---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
const criteria = [
  ['Professional or Civic Background', 'Applicants should be professionals (lawyers, doctors, educators, corporate employees), skilled workers, or dedicated students willing to offer their specific expertise.'],
  ['Ethical Alignment', 'A firm belief in justice, equality, and the core Islamic values of brotherhood, empathy, and social responsibility.'],
  ['Action-Oriented Mindset', 'Membership is not a mere title or a resume addition. Members must be willing to dedicate actual time and physical effort—whether that means fighting a pro-bono case, spending a weekend at a medical camp, or distributing food during Ramadan.'],
  ['Clean Record', 'Members must possess a strong moral character with no history of professional misconduct or criminal convictions.'],
];
const conduct = [
  ['Absolute Confidentiality (Legal & Medical)', 'Many who seek our help are in vulnerable situations. Our legal and medical volunteers must maintain strict attorney-client and doctor-patient confidentiality. The dignity and privacy of those we help are non-negotiable.'],
  ['Zero Financial Solicitation', 'Takweyat is a coalition of civil society, not a fundraising agency. Members are strictly prohibited from soliciting, collecting, or managing financial donations from the public in the name of the organization. All contributions are made through personal time, professional expertise, or direct in-kind support.'],
  ['Apolitical & Non-Partisan Stance', 'We serve humanity, not political parties. Takweyat operates independently of all political organizations. Members must not use the platform to promote political agendas or engage in partisan activism.'],
  ['Equality and Respect', 'We assist everyone regardless of their background, status, or belief. Members must treat all beneficiaries, colleagues, and community members with absolute respect, patience, and compassion.'],
  ['Commitment to Safety', 'Whether navigating a flood disaster zone or visiting a remote school, members must adhere to the safety guidelines set by the core team to protect themselves and those they are helping.'],
  ['Representation', 'Members must remember that their public behavior reflects on the entire organization. Professionalism in speech, attire, and conduct is expected at all times when representing Takweyat.'],
];
const onboarding = [
  ['Application', 'Submit your professional details and area of interest via our Contact Form.'],
  ['Review', 'Our core committee reviews the application to match your skills with our current on-ground needs.'],
  ['Orientation', 'Selected volunteers undergo a brief orientation regarding our operational ethics and current projects before their first deployment.'],
];
---
<Base title="Join the movement" description="Excellence in character. Dedication in action. Membership criteria, code of conduct and onboarding at Takweyat.">
  <PageHead title="Excellence in Character. Dedication in Action." tone="olive" lede="Takweyat (تقویت) is built on the integrity and expertise of its members. Because we operate directly with vulnerable communities, handle sensitive legal and medical matters, and represent the best of civil society, we hold our members to the highest ethical and professional standards. Joining us means making a serious commitment to societal upliftment." crumbs={[{ label: 'Get involved', href: '/get-involved/' }]} />

  <section class="band">
    <div class="wrap cols2 wide-left">
      <div>
        <h2 class="h2">Membership Criteria: Who Can Join?</h2>
        <p class="lede" style="margin-top:20px">We do not ask for membership fees, but we do demand dedication. To join the Takweyat network, individuals must meet the following criteria:</p>
      </div>
      <ul class="ticks" style="--c:var(--olive)">
        {criteria.map(([t, d]) => <li data-rise><b>{t}:</b> {d}</li>)}
      </ul>
    </div>
  </section>

  <section class="band bg-white">
    <div class="wrap cols2 wide-left">
      <div>
        <h2 class="h2">Code of Conduct: Our Operational Ethics</h2>
        <p class="lede" style="margin-top:20px">Every volunteer, member, and partner acting under the banner of Takweyat is bound by this Code of Conduct.</p>
      </div>
      <ul class="ticks" style="--c:var(--teal)">
        {conduct.map(([t, d]) => <li data-rise><b>{t}:</b> {d}</li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px">The Onboarding Process</h2>
      <ol class="steps" style="max-width:860px">
        {onboarding.map(([t, d]) => <li data-rise><div><b>{t}:</b> {d}</div></li>)}
      </ol>
      <div class="btns" style="margin-top:40px"><a class="btn" href="/contact/"><span>Apply through the contact form</span><Arrow /></a></div>
    </div>
  </section>
</Base>
