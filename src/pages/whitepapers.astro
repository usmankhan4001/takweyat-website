---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
// A download button appears automatically as soon as its PDF is placed in public/downloads.
const docs = [
  { title: 'The Educational Plan', sub: 'The Global Vision. 35 pillars in full.', file: '/downloads/takweyat-educational-plan.pdf', page: '/plans/education/', color: 'var(--teal)' },
  { title: 'The Global Legal Aid and Justice Plan', sub: 'The Manifesto of Rights. 50 pillars in full.', file: '/downloads/takweyat-legal-aid-and-justice-plan.pdf', page: '/plans/justice/', color: 'var(--raspberry)' },
  { title: 'Takweyat at a glance', sub: 'Who we are, what we do and how to take part.', file: '/downloads/takweyat-profile.pdf', page: '/about/', color: 'var(--olive)' },
].map((d) => ({ ...d, ready: fs.existsSync('public' + d.file) }));
---
<Base title="Whitepapers" description="Designed documents for readers who want the full detail of Takweyat's plans.">
  <PageHead img="/media/banners/whitepapers.jpg" title="Whitepapers" tone="charcoal" lede="For readers who want everything: each plan as a designed document, with every pillar in full." />
  <section class="band">
    <div class="wrap">
      <div class="grid g2">
        {docs.map((d) => (
          <article class="card" style={`background:${d.color};color:var(--white);min-height:300px;padding:clamp(24px,3vw,40px)`} data-rise>
            <h3 class="h3">{d.title}</h3>
            <p style="color:inherit">{d.sub}</p>
            <div class="btns" style="margin-top:auto">
              {d.ready
                ? <a class="btn white" href={d.file} download><span>Download PDF</span><Arrow /></a>
                : <span class="status" style="background:rgb(255 255 255 / .2);color:inherit">Designed PDF in preparation</span>}
              <a class="more" href={d.page}>Read online</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
