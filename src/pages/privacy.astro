---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'privacy');
const { site } = await getCms();
---
<Base title={t('privacy_and_confidentiality')} description="How Takweyat handles the information you share with us.">
  <PageHead title={t('privacy_and_confidentiality_2')} tone="charcoal" lede="The dignity and privacy of those we help are non-negotiable." />
  <section class="band">
    <div class="wrap prose stack">
      <h2 class="h3">{t('what_we_ask_for')}</h2>
      <p>{t('when_you_send_us_a_form')}</p>
      <h2 class="h3">{t('how_we_use_it')}</h2>
      <p>{t('we_use_your_details_to_answer')}</p>
      <h2 class="h3">{t('confidentiality_of_legal_and_medical_matters')}</h2>
      <p>{t('our_legal_and_medical_volunteers_are')}</p>
      <h2 class="h3">{t('this_website')}</h2>
      <p>{t('this_website_does_not_use_advertising')}</p>
      <h2 class="h3">{t('questions_or_requests')}</h2>
      <p>{t('to_ask_what_we_hold_about')} <a href={`mailto:${site.email}`}><b>{site.email}</b></a>.</p>
    </div>
  </section>
</Base>
