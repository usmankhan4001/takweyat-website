---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'accessibility');
const { site } = await getCms();
---
<Base title={t('accessibility')} description="How Takweyat is working to make this website usable by everyone.">
  <PageHead title={t('accessibility_2')} tone="charcoal" lede="Information about justice and help should reach everyone." />
  <section class="band">
    <div class="wrap prose stack">
      <p>{t('we_aim_to_make_this_website')}</p>
      <p>{t('if_something_on_this_site_is')} <a href={`mailto:${site.email}`}><b>{site.email}</b></a>.</p>
    </div>
  </section>
</Base>
