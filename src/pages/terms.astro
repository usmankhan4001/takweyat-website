---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'terms');
const { site } = await getCms();
---
<Base title={t('terms_and_disclaimer')} description="Terms of use and an important note about the information on the Takweyat website.">
  <PageHead title={t('terms_and_disclaimer_2')} tone="charcoal" lede="Please read this before relying on anything on this website." />
  <section class="band">
    <div class="wrap prose stack">
      <h2 class="h3">{t('general_information_only')}</h2>
      <p>{t('the_information_on_this_website_is')}</p>
      <h2 class="h3">{t('sending_us_a_form')}</h2>
      <p>{t('sending_a_form_or_an_email')}</p>
      <h2 class="h3">{t('plans_and_goals')}</h2>
      <p>{t('the_educational_plan_and_the_legal')}</p>
      <h2 class="h3">{t('no_fundraising')}</h2>
      <p>{t('takweyat_does_not_ask_the_public')} <a href={`mailto:${site.email}`}><b>{site.email}</b></a>.</p>
      <h2 class="h3">{t('external_links')}</h2>
      <p>{t('links_to_other_websites_including_our')}</p>
    </div>
  </section>
</Base>
