---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { coreSlugs } from '../../data/initiatives';
import { getCms, copyFor } from '../../lib/cms';
const t = copyFor(await getCms(), 'what-we-do-slug');
const { core } = await getCms();

const i = coreSlugs.indexOf(Astro.params.slug as string);
if (i < 0 || !core.pillars[i]) return Astro.rewrite('/404');
const p = core.pillars[i];
const tones = ['teal', 'raspberry', 'olive', 'charcoal', 'teal'] as const;
const colors = ['var(--teal)', 'var(--raspberry)', 'var(--teal-dark)', 'var(--teal)', 'var(--raspberry)']; // never charcoal: it would vanish against the dark hero
const lt = p.title.toLowerCase();
const art = `/media/art/pillar-${/educat/.test(lt) ? 'education' : /hunger|food/.test(lt) ? 'hunger' : /disaster|climate/.test(lt) ? 'disaster' : /medic|health/.test(lt) ? 'health' : 'rights'}.jpg`;
const artOf = (t: string) => { const l = t.toLowerCase(); return `/media/art/pillar-${/educat/.test(l) ? 'education' : /hunger|food/.test(l) ? 'hunger' : /disaster|climate/.test(l) ? 'disaster' : /medic|health/.test(l) ? 'health' : 'rights'}.jpg`; };
const prev =core.pillars[(i + 4) % 5], next = core.pillars[(i + 1) % 5];
const deeper = i === 0
  ? { href: '/plans/education/', label: 'Read the Educational Plan', text: 'The full vision behind this pillar, in 35 pillars across four phases.' }
  : i === 2
  ? { href: '/plans/justice/', label: 'Read the Legal Aid and Justice Plan', text: 'The full manifesto behind this pillar, in 50 pillars across four phases.' }
  : null;
---
<Base title={p.title} description={p.goal}>
  <section class="pillar-hero" style={`--c:${colors[i]}`}>
    <div class="wrap phg-grid">
      <div class="ph-text">
        <p class="crumbs"><a href="/what-we-do/">{t('what_we_do')}</a> / Pillar {i + 1} of 5</p>
        <h1 class="h1">{p.title}</h1>
        <p class="lede">{p.goal}</p>
        <div class="btns"><a class="btn white" href="#objectives"><span>{t('see_the_objectives')}</span><Arrow /></a></div>
      </div>
      <div class="ph-art"><img src={art} alt="" width="1600" height="1200" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="band road" style={`--c:${colors[i]}`}>
    <div class="wrap road-in">
      <p class="small">{t('roadmap')}</p>
      <p class="road-q">{p.roadmap}</p>
    </div>
  </section>

  {deeper && (
    <section class="band tight bg-white">
      <div class="wrap">
        <div class="card deeper" style={`--c:${colors[i]}`}>
          <div><h3>{t('go_deeper')}</h3><p>{deeper.text}</p></div>
          <a class="btn teal" href={deeper.href}><span>{deeper.label}</span><Arrow /></a>
        </div>
      </div>
    </section>
  )}

  <section class="band bg-white" id="objectives">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:40px">{t('strategic_objectives')}</h2>
      <ol class="objs" style={`--c:${colors[i]}`}>
        {p.objectives.map((o, n) => <li data-rise><b>{String(n + 1).padStart(2, '0')}</b><span>{o}</span></li>)}
      </ol>
      <div class="btns" style="margin-top:48px">
        <a class="btn" href="/volunteer/"><span>{t('bring_your_profession_to_this_work')}</span><Arrow /></a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap pnav">
      {[[prev, (i + 4) % 5, 'Previous pillar'], [next, (i + 1) % 5, 'Next pillar']].map(([q, k, lab]) => (
        <a href={`/what-we-do/${coreSlugs[k as number]}/`}>
          <img src={artOf((q as any).title)} alt="" width="1000" height="750" loading="lazy" />
          <span><small>{lab}</small><b>{(q as any).title}</b></span>
        </a>
      ))}
    </div>
  </section>
</Base>
