---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCms } from '../lib/cms';
const { site } = await getCms();
---
<Base title="Media kit" description="Logo files, a short description and contact details for journalists writing about Takweyat.">
  <PageHead title="Media kit" tone="charcoal" lede="Everything a journalist or partner needs to describe Takweyat accurately." crumbs={[{ label: 'Press', href: '/press/' }]} />
  <section class="band">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:28px">Short description</h2>
      <p class="lede" style="max-width:70ch">Takweyat (تقویت) is a dedicated organization of individuals united by a single mission: to bring positive change and provide strength to society. Whatever the issue, we stand ready to empower communities, uplift the marginalized, and build a stronger, fairer world.</p>
    </div>
  </section>
  <section class="band bg-white">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:28px">Logo</h2>
      <div class="grid g2">
        <div class="card paper"><img src="/logo.png" alt="Takweyat logo on a light background" width="380" /><p class="small">For light backgrounds</p><a class="more" href="/brand/takweyat-logo-teal.png" download>Download PNG</a></div>
        <div class="card" style="background:var(--charcoal);color:var(--paper)"><img src="/brand/takweyat-logo-white.png" alt="Takweyat logo on a dark background" width="380" /><p class="small" style="color:inherit">For dark backgrounds</p><a class="more" href="/brand/takweyat-logo-white.png" download>Download PNG</a></div>
      </div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:28px">Brand kit</h2>
      <div class="grid g3">
        <div class="card paper"><img src="/brand/takweyat-mark-512.png" alt="The Takweyat hands mark" width="160" height="160" /><p class="small">The mark</p><a class="more" href="/brand/takweyat-mark-512.png" download>Download PNG</a></div>
        <div class="card paper"><img src="/brand/takweyat-logo-teal.png" alt="Takweyat logo in teal" width="300" /><p class="small">Logo, teal</p><a class="more" href="/brand/takweyat-logo-teal.png" download>Download PNG</a></div>
        <div class="card" style="background:var(--teal);color:#fff"><img src="/brand/takweyat-logo-white.png" alt="Takweyat logo in white" width="300" /><p class="small" style="color:inherit">Logo, white</p><a class="more" href="/brand/takweyat-logo-white.png" download>Download PNG</a></div>
      </div>
      <ul class="swatches" aria-label="Brand colours">
        <li style="--sw:#007A7A"><b>Teal</b><span>#007A7A</span></li>
        <li style="--sw:#A21E66"><b>Raspberry</b><span>#A21E66</span></li>
        <li style="--sw:#7B7B7B"><b>Slate</b><span>#7B7B7B</span></li>
        <li style="--sw:#0B0902"><b>Charcoal</b><span>#0B0902</span></li>
      </ul>
    </div>
  </section>
  <section class="band tight">
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:12px">Contact</h2>
      <p><a class="more" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>
