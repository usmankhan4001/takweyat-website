---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LeadForm from '../components/LeadForm.astro';
import { professions, subjects } from '../data/networks';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'contact');
const { site } = await getCms();
---
<Base title={t('contact_us')} description="Volunteer and membership inquiries, free legal aid, and institutional collaboration with Takweyat International Organization.">
  <PageHead img="/media/banners/contact.jpg" title={t('contact_us_2')} tone="raspberry" lede="Volunteer and membership inquiries, legal aid, and institutional collaboration all start here." />

  <section class="band">
    <div class="wrap cols2 wide-left">
      <div>
        <h2 class="h2" style="margin-bottom:28px">{t('digital_contact_membership_form')}</h2>
        <LeadForm id="contact" submit="Send Message" fields={[
          { name: 'name', label: 'Full Name', short: 'Name', help: 'So we know who to reply to.', ph: 'Your full name', required: true },
          { name: 'email', label: 'Email Address', short: 'Email', help: 'We will reply to this address.', ph: 'name@example.com', type: 'email', required: true },
          { name: 'phone', label: 'Phone Number', short: 'Phone', help: 'Only if you would like a call. You can skip this.', ph: '03XX XXXXXXX', type: 'tel' },
          { name: 'profession', label: 'Profession / Area of Expertise', short: 'Profession', help: 'Choose the one that fits you best.', type: 'select', options: professions, required: true },
          { name: 'subject', label: 'Subject', short: 'Subject', help: 'What is your message about?', type: 'select', options: subjects, required: true },
          { name: 'message', label: 'Message', short: 'Message', ph: 'Write here...', type: 'textarea', hint: 'Tell us how you would like to contribute your skills', required: true },
        ]} />
      </div>
      <aside class="stack">
        <div class="card" style="--c:var(--raspberry)">
          <h3>{t('immediate_help_desks')}</h3>
          {site.phone && <p><b>{t('volunteer_membership_inquiries')}</b> {site.phone}</p>}
          {site.helpline && <p><b>{t('free_legal_aid_helpline')}</b> {site.helpline}<br /><span class="small">{t('for_individuals_facing_immediate_human_rights')}</span></p>}
          <p><b>{t('email')}</b> <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="card" style="--c:var(--teal)">
          <h3>{t('official_offices')}</h3>
          {site.offices.map((o) => <p><b>{o.name}</b><br />{o.lines.join(', ')}</p>)}
        </div>
      </aside>
    </div>
  </section>
</Base>
