---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'contact');
const { site, forms } = await getCms();
---
<Base title={t('contact_us')} description="Volunteer and membership inquiries, free legal aid, and institutional collaboration with Takweyat International Organization.">
  <PageHead img="/media/banners/contact.jpg" title={t('contact_us_2')} tone="raspberry" lede="Volunteer and membership inquiries, legal aid, and institutional collaboration all start here." />

  <section class="band">
    <div class="wrap cols2 wide-left">
      <div>
        <h2 class="h2" style="margin-bottom:28px">{t('digital_contact_membership_form')}</h2>
        <LeadForm id="contact" submit="Send Message" fields={forms.contact} />
      </div>
      <aside class="stack">
        <div class="card" style="--c:var(--raspberry)">
          <h3>{t('immediate_help_desks')}</h3>
          {site.phone && <p><b>{t('volunteer_membership_inquiries')}</b> {site.phone}</p>}
          {site.helpline && <p><b>{t('free_legal_aid_helpline')}</b> {site.helpline}<br /><span class="small">{t('for_individuals_facing_immediate_human_rights')}</span></p>}
          <p><b>{t('email')}</b> <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="card" style="--c:var(--teal)">
          <h3>{t('official_offices')}</h3>
          {site.offices.map((o) => <p><b>{o.name}</b><br />{o.lines.join(', ')}</p>)}
        </div>
      </aside>
    </div>
  </section>
</Base>
