---
import ActionPage from '../components/ActionPage.astro';
import { partner } from '../data/forms';
import { getCms } from '../lib/cms';
const { networks } = await getCms();
---
<ActionPage title="Partner with us" id="partner" img="/media/banners/initiatives.jpg" headline="Partner with us" lede="For businesses, institutions and organisations that want to work alongside Takweyat." submit="Send Proposal"
  points={[
    { h: networks[4].title, t: networks[4].text },
    { h: 'Tell us your idea', t: 'A few short questions about your organisation and what you would like to do together.' },
    { h: 'What happens next', t: 'We read every proposal and reply by email.' }]}
  fields={partner} />
