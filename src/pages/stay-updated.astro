---
import ActionPage from '../components/ActionPage.astro';
import { getCms, copyFor } from '../lib/cms';
const { updates } = (await getCms()).forms;
const t = copyFor(await getCms(), 'stay-updated');
---
<ActionPage title={t('stay_updated')} id="updates" img="/media/banners/press.jpg" headline="Stay updated" lede="A short email when something important happens. No fundraising." submit="Subscribe"
  points={[
    { h: 'Only real news', t: 'We write when there is something worth reading.' },
    { h: 'No fundraising', t: 'Takweyat does not ask for funds.' },
    { h: 'Leave any time', t: 'Every email will have a way to unsubscribe.' }]}
  fields={updates} />
