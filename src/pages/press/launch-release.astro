---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import { boilerplate } from '../../data/press';
import { getCms, copyFor } from '../../lib/cms';
const t = copyFor(await getCms(), 'press-launch-release');
const { site, releases } = await getCms();
const r = releases[0];
const hasPdf = true; // the stub PDF ships with the site
---
<Base title={t('launch_release_stub')} description={r.summary}>
  <PageHead title={t('launch_release_stub_2')} tone="teal" crumbs={[{ label: 'Press', href: '/press/' }]} lede={r.summary}>
    {hasPdf && <div class="btns" style="margin-top:28px"><a class="btn cream" href={r.pdf} download><span>{t('download_the_stub_pdf')}</span><Arrow /></a></div>}
  </PageHead>
  <section class="band">
    <div class="wrap">
      <article class="prose" style="background:var(--white);border-radius:var(--r);padding:clamp(24px,4vw,56px);max-width:820px">
        <p class="small"><b>{t('for_immediate_release')}</b></p>
        <h2 class="h3" style="margin-top:12px">{t('headline_what_is_being_announced_in')}</h2>
        <p style="margin-top:18px"><b>{t('city_date')}</b> {t('opening_paragraph_who_what_when_and')}</p>
        <p>{t('second_paragraph_why_it_matters_and')}</p>
        <p>{t('a_short_quotation_from_a_spokesperson')}</p>
        <p>{t('practical_details_how_to_take_part')}</p>
        <h3 style="margin-top:28px;font-size:1.3rem">{t('about_takweyat_international_organization')}</h3>
        <p>{boilerplate}</p>
        <h3 style="margin-top:28px;font-size:1.3rem">{t('media_contact')}</h3>
        <p>{site.email}</p>
      </article>
    </div>
  </section>
</Base>
