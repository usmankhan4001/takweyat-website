---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import { boilerplate, releases } from '../../data/press';
import { site } from '../../data/site';
const r = releases[0];
import fs from 'node:fs';
const hasPdf = fs.existsSync('public' + r.pdf);
---
<Base title="Launch release (stub)" description={r.summary}>
  <PageHead title="Launch release (stub)" tone="teal" crumbs={[{ label: 'Press', href: '/press/' }]} lede={r.summary}>
    {hasPdf && <div class="btns" style="margin-top:28px"><a class="btn cream" href={r.pdf} download><span>Download the stub (PDF)</span><Arrow /></a></div>}
  </PageHead>
  <section class="band">
    <div class="wrap">
      <article class="prose" style="background:var(--white);border-radius:var(--r);padding:clamp(24px,4vw,56px);max-width:820px">
        <p class="small"><b>FOR IMMEDIATE RELEASE</b></p>
        <h2 class="h3" style="margin-top:12px">[Headline: what is being announced, in one clear line]</h2>
        <p style="margin-top:18px"><b>[City, Date]</b> — [Opening paragraph: who, what, when and where, in two or three sentences.]</p>
        <p>[Second paragraph: why it matters and who it helps.]</p>
        <p>[A short quotation from a spokesperson, with name and role.]</p>
        <p>[Practical details: how to take part, how to get help, or where to find out more.]</p>
        <h3 style="margin-top:28px;font-size:1.3rem">About Takweyat International Organization</h3>
        <p>{boilerplate}</p>
        <h3 style="margin-top:28px;font-size:1.3rem">Media contact</h3>
        <p>{site.email}</p>
      </article>
    </div>
  </section>
</Base>
