---
import ActionPage from '../../components/ActionPage.astro';
import { press } from '../../data/forms';
---
<ActionPage title="Press enquiries" id="press" img="/media/banners/press.jpg" headline="Press enquiries" lede="Journalists and editors looking for information, interviews or images." submit="Send Enquiry"
  points={[
    { h: 'Who this is for', t: 'Journalists, editors and producers.' },
    { h: 'What you can ask for', t: 'Interviews, facts about our work, and images. The media kit has our logos and basics.' },
    { h: 'What happens next', t: 'We read every enquiry and reply by email.' }]}
  fields={press} />
