---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Arrow from '../../../components/Arrow.astro';
import { eduGroups, groupOf } from '../../../data/groups';
import { getCms, copyFor } from '../../../lib/cms';
const t = copyFor(await getCms(), 'plans-education-n');
const { edu } = await getCms();

const p = edu.pillars.find((x: any) => String(x.number) === Astro.params.n);
if (!p) return Astro.rewrite('/404');
const group = groupOf(eduGroups, p.number);
const P = new Map(edu.pillars.map((x) => [x.number, x]));
const prev = P.get(p.number - 1), next = P.get(p.number + 1);
const related = group.pillars.filter((n) => n !== p.number);
---
<Base title={`Pillar ${p.number}: ${p.title}`} description={p.items[0]}>
  <PageHead title={p.title} tone="teal" crumbs={[{ label: 'Our plans', href: '/plans/' }, { label: 'The Educational Plan', href: '/plans/education/' }]} tag={`Pillar ${p.number} of 35 · ${group.name} · Planned`} />

  <section class="band">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:28px">{t('ten_commitments')}</h2>
      <ul class="bullets" style="--c:var(--teal)">
        {p.items.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  {related.length > 0 && (
    <section class="band bg-white tight">
      <div class="wrap">
        <h2 class="h3" style="margin-bottom:20px">More in {group.name}</h2>
        <div class="grid g2">
          {related.map((n) => <a class="pcard" href={`/plans/education/${n}/`} style="--c:var(--teal)"><b>{n}</b><span>{P.get(n)!.title}</span></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="band tight">
    <div class="wrap">
      <div class="pn">
        {prev ? <a href={`/plans/education/${prev.number}/`}><small>{t('previous_pillar')}</small><span>{prev.number}. {prev.title}</span></a> : <span style="flex:1 1 280px"></span>}
        {next ? <a class="next" href={`/plans/education/${next.number}/`}><small>{t('next_pillar')}</small><span>{next.number}. {next.title}</span></a> : <span style="flex:1 1 280px"></span>}
      </div>
      <div class="btns" style="margin-top:32px">
        <a class="btn" href="/get-involved/"><span>{t('bring_your_profession_to_this_work')}</span><Arrow /></a>
        <a class="btn outline" href="/plans/education/"><span>{t('all_35_pillars')}</span></a>
      </div>
    </div>
  </section>
</Base>
