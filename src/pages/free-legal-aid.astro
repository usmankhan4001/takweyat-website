---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LeadForm from '../components/LeadForm.astro';
import Photo from '../components/Photo.astro';
import { legalAid } from '../data/forms';
import { scope, steps } from '../data/legalAid';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'free-legal-aid');
const { site } = await getCms();
const eligibility = [
  ['Financial Inability', 'Must be unable to afford standard legal fees (proof of income or a genuine declaration of financial hardship is required).'],
  ['Merit of the Case', 'The case must involve a genuine violation of rights, a threat to liberty, or severe exploitation.'],
  ['Vulnerability Status', 'Priority is given to widows, orphans, minorities, under-trial prisoners without representation, and victims of extreme physical or mental abuse.'],
];
const [headOffice, chamber] = site.offices;
---
<Base title={t('free_legal_aid')} description="Justice is a fundamental right, not a privilege. Takweyat's Legal Aid Network provides free legal counseling and court representation.">
  <PageHead img="/media/banners/legal-aid.jpg" title={t('justice_is_a_fundamental_right_not')} tone="raspberry" crumbs={[{ label: 'Free legal aid', href: '/free-legal-aid/' }]}>
    <div class="btns" style="margin-top:32px"><a class="btn white" href="#apply"><span>{t('apply_for_legal_aid')}</span></a></div>
  </PageHead>

  <section class="band">
    <div class="wrap cols2 wide-left">
      <p class="lede" data-rise style="max-width:none">{t('at_takweyat_we_believe_that_a')}</p>
      <Photo caption="Scales of justice, gavel and law books" video="/media/justice.mp4" poster="/media/justice.jpg" ratio="4 / 5" />
    </div>
  </section>

  <section class="band bg-white">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px">{t('scope_of_cases_we_take')}</h2>
      <ul class="glance" style="--c:var(--raspberry)">{scope.map(([t]) => <li>{t}</li>)}</ul>
      <details class="seeall">
        <summary>{t('see_what_each_covers')}</summary>
        <ul class="ticks" style="--c:var(--raspberry)">
          {scope.map(([t, d]) => <li><b>{t}:</b> {d}</li>)}
        </ul>
      </details>
      <p class="small" style="margin-top:28px;max-width:80ch"><b>{t('note')}</b> {t('we_do_not_accept_commercial_corporate')}</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap cols2 wide-left">
      <div>
        <h2 class="h2">{t('eligibility_criteria')}</h2>
        <p class="lede" style="margin-top:20px">{t('our_resources_and_volunteer_hours_are')}</p>
      </div>
      <ol class="steps">
        {eligibility.map(([t, d]) => <li data-rise><div><b>{t}:</b> {d}</div></li>)}
      </ol>
    </div>
  </section>

  <section class="band bg-white">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px">{t('how_to_apply_the_4_step')}</h2>
      <ol class="steps" style="max-width:860px">
        {steps.map(([t, d]) => <li data-rise><div><b>{t}:</b> {d}</div></li>)}
      </ol>
    </div>
  </section>

  <section class="band" id="apply">
    <div class="wrap">
      <div>
        <h2 class="h2" style="margin-bottom:12px">{t('the_legal_aid_application_form')}</h2>
        <p class="small" style="margin-bottom:28px;max-width:60ch">{t('everything_you_write_here_is_confidential')}</p>
        <LeadForm id="legal-aid" tone="raspberry" note="Private and confidential" minutes={3} submit="Submit Confidential Application" fields={legalAid} />
      </div>
      <aside class="card" style="--c:var(--raspberry);margin-top:40px">
        <h3>{t('emergency_legal_contacts_chambers')}</h3>
        {site.helpline && <p><b>{t('24_7_legal_aid_helpline')}</b> {site.helpline}</p>}
        <p><b>{headOffice.name}</b><br />{headOffice.lines.join(', ')}</p>
        <p><b>{chamber.name}</b><br />{chamber.lines.join(', ')}</p>
        <p><b>{t('email')}</b><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </aside>
    </div>
  </section>
</Base>
