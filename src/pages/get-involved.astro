---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
import LeadForm from '../components/LeadForm.astro';
import { volunteer } from '../data/forms';
import { getCms, copyFor } from '../lib/cms';
const t = copyFor(await getCms(), 'get-involved');
const { networks } = await getCms();
const netIcons = ['social-impact', 'medical-aid', 'education-support', 'disaster-relief', 'global-aid'];
const netColors = ['var(--teal)', 'var(--teal-dark)', 'var(--teal-dark)', 'var(--teal)', 'var(--charcoal)'];
const netWipes = ['var(--teal-dark)', 'var(--teal)', 'var(--teal)', 'var(--teal-dark)', 'var(--teal)'];
---
<Base title={t('get_involved')} description="We don't ask for funds. We ask for your expertise. Join one of Takweyat's five volunteer networks.">
  <PageHead img="/media/banners/get-involved.jpg" title={t('we_don_t_ask_for_funds')} tone="teal" lede="Takweyat operates on the strength of its people. We are actively seeking driven professionals, field workers, and subject-matter experts who want to contribute their time and skills to our active missions." crumbs={[{ label: 'Get involved', href: '/get-involved/' }]} />

  <section class="band">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:12px">{t('how_you_can_contribute')}</h2>
      <p class="lede" style="margin-bottom:44px">{t('choose_the_network_that_matches_your')}</p>
      <div class="nets">
        {networks.map((n, i) => (
          <a class="net" href="#volunteer" style={`--c:${netColors[i]};--w:${netWipes[i]};--ic:url(/icons/${netIcons[i]}.svg)`} data-rise>
            <span class="net-ic" aria-hidden="true"></span>
            <span class="meta">{n.who}</span>
            <h3>{n.title}</h3>
            <p>{n.text}</p>
            <span class="net-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="btns" style="margin-top:48px">
        <a class="btn outline" href="/join/"><span>{t('who_can_join_and_our_code')}</span></a>
        <a class="btn outline" href="/partner/"><span>{t('partner_with_us')}</span></a>
      </div>
    </div>
  </section>
  <section class="band bg-white" id="volunteer">
    <div class="wrap">
      <div style="margin-bottom:36px"><h2 class="h2">{t('become_a_volunteer')}</h2><p class="lede" style="margin-top:16px">{t('tell_us_who_you_are_in')}</p></div>
      <LeadForm id="volunteer" submit="Send My Details" fields={volunteer} />
    </div>
  </section>
</Base>
